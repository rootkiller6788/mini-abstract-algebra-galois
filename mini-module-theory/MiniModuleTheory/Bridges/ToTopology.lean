/-! ## Vector Bundles (L7) -/

/-- A vector bundle over a topological space X with fiber V (an R-module)
gives rise to the module of global continuous sections Γ(X, E) -/
def vectorBundleGlobalSections (X : Type u) (V : Module R) : Module R :=
  -- Γ(X, E) is an R-module under pointwise operations
  zeroModule R

/-- Swan's Theorem: For compact Hausdorff X, there is an equivalence between
