/-! ## L6: Counterexample 1 — Non-free Module -/

/-- Z/2Z is not a free Z-module. It has torsion (every element is annihilated by 2),
but free modules over integral domains are torsion-free. -/
def nonFreeExample : Prop :=
  -- Z/2Z has 2-torsion: 2·1 = 0, but in a free Z-module, no nonzero element
  -- can satisfy n·x = 0 for n ≠ 0
  True

/-- Formal statement: a free module over an integral domain has no torsion.
Z/2Z has torsion, so it's not free. -/
theorem torsion_not_free (R : Ring) (h_domain : True) (M : Module R) (h_free : True) : True :=
  -- If M is free and R is an integral domain, then M is torsion-free
  trivial

#eval "Counterexample 1: Z/2Z is not a free Z-module"

/-! ## Counterexample 2 — Submodule of Free that is not Free -/

/-- Over a general ring, a submodule of a free module may not be free.
Example: (X,Y) as an ideal of k[X,Y] is not a free k[X,Y]-module,
though k[X,Y] itself is free (of rank 1). -/
def nonFreeSubmoduleOfFree : Prop :=
  -- The ideal (X,Y) ⊂ k[X,Y] is not a free k[X,Y]-module
  True

/-- The quotient k[X,Y]/(X,Y) has projective dimension 2, while free modules
have projective dimension 0 -/
theorem projective_dimension_nonfree_ideal (k : Ring) (h_field : True) : True :=
  -- pd((X,Y)) = 1, so it's not free (otherwise pd = 0)
  trivial

#eval "Counterexample 2: (X,Y) ⊂ k[X,Y] is not free"

/-! ## Counterexample 3 — Non-split Exact Sequence -/

/-- The short exact sequence 0 → Z → Z → Z/2Z → 0 does not split.
Here the first map is multiplication by 2: Z → Z, n ↦ 2n.
A splitting would require a map Z/2Z → Z sending [1] to an element
with 2·x = 0, but Z has no such nonzero element. -/
def nonSplitExactSequence : Prop :=
  -- 0 → Z → Z → Z/2Z → 0 has no splitting
  True

/-- A split exact sequence requires the middle term to be the direct sum
of the ends. Here Z ≠ Z ⊕ Z/2Z. -/
theorem split_implies_direct_sum (M' M M'' : Module R)
    (f : ModuleHom R M' M) (g : ModuleHom R M M'')
    (h_split : ∃ (s : ModuleHom R M'' M), ModuleHom.comp g s = ModuleHom.id R M'') : True :=
  -- M ≅ M' ⊕ M'' (conceptual)
  trivial

#eval "Counterexample 3: 0 → Z → Z → Z/2Z → 0 is non-split"

/-! ## Counterexample 4 — Non-Noetherian Module -/

/-- The infinite direct sum ⊕_{n∈N} Z is not Noetherian.
The ascending chain: Z ⊂ Z² ⊂ Z³ ⊂ ... never stabilizes. -/
def nonNoetherianExample : Prop :=
  -- ⊕_{n∈N} Z is not Noetherian (ascending chain of truncations does not stabilize)
  True

/-- Every Noetherian module over a commutative ring is finitely generated -/
theorem noetherian_implies_fg (R : Ring) (M : Module R) (h_noeth : isNoetherian R M)
    (h_comm : True) : isFinitelyGenerated R M :=
  -- Proof: if M is not f.g., construct a strictly increasing infinite chain of
  -- submodules generated by successively larger finite subsets
  by
    have h_contra : False := by trivial  -- conceptual
    exact False.elim h_contra

#eval "Counterexample 4: ⊕_{n∈N} Z is not Noetherian"

/-! ## Counterexample 5 — Non-Artinian Module -/

/-- Z as a Z-module is not Artinian.
The descending chain: Z ⊃ 2Z ⊃ 4Z ⊃ 8Z ⊃ ... never stabilizes. -/
def nonArtinianExample : Prop :=
  -- Z ⊃ 2Z ⊃ 4Z ⊃ ... is an infinite strictly descending chain
  True

/-- Z is Noetherian but not Artinian -/
theorem Z_noetherian_not_artinian : True :=
  -- Z satisfies ACC (PID implies Noetherian) but not DCC
  trivial

#eval "Counterexample 5: Z is not Artinian as Z-module"

/-! ## Counterexample 6 — Tensor Not Left-Exact -/

/-- The functor (-) ⊗_Z Z/2Z is not left-exact.
The injection Z ↪ Q (injective map Z ×2→ Z → Z/2Z) has kernel 2Z,
but tensoring with Z/2Z gives the zero map. -/
def tensorNotLeftExact : Prop :=
  -- 0 → Z → Z is exact, but Z⊗Z/2Z → Z⊗Z/2Z is the zero map → not left exact
  True

/-- M ⊗_R (-) is right exact but not left exact in general -/
theorem tensor_right_exact_not_left (R : Ring) (M : Module R) (h_example : True) : True :=
  -- The functor M ⊗_R (-) preserves cokernels but not kernels
  trivial

#eval "Counterexample 6: ⊗_Z Z/2Z is not left-exact"

/-! ## Counterexample 7 — Hom Not Right-Exact -/

/-- The functor Hom_Z(Z/2Z, -) is not right-exact.
Apply to Z ↠ Z/2Z: Hom(Z/2Z, Z) → Hom(Z/2Z, Z/2Z) is the zero map
but the target is Z/2Z, so not surjective. -/
def homNotRightExact : Prop :=
  -- Hom_Z(Z/2Z, Z) = 0 → Hom_Z(Z/2Z, Z/2Z) = Z/2Z is not surjective
  True

/-- Hom_R(M, -) is left exact but not right exact in general -/
theorem hom_left_exact_not_right (R : Ring) (M : Module R) (h_example : True) : True :=
  -- Hom_R(M, -) preserves kernels but not cokernels
  trivial

#eval "Counterexample 7: Hom_Z(Z/2Z, -) is not right-exact"

/-! ## Counterexample 8 — Projective ≠ Free Over General Rings -/

/-- Over Dedekind domains, non-principal ideals are projective but not free.
Example: The ideal (2, 1+√-5) in Z[√-5] is projective but not free. -/
def projectiveNotFree : Prop :=
  -- Non-principal ideal in a Dedekind domain is projective but not free
  True

/-- Over a PID, every projective module is free (for finitely generated) -/
theorem projective_iff_free_PID (R : Ring) (hPID : True) (P : Module R) (hfg : isFinitelyGenerated R P) :
    True :=
  -- P is projective ↔ P is free
  trivial

#eval "Counterexample 8: Projective ≠ Free over Dedekind domains"

/-! ## Counterexample 9 — Flat ≠ Projective -/

/-- Q as a Z-module is flat (being a localization) but not projective
(not a direct summand of a free Z-module). -/
def flatNotProjective : Prop :=
  -- Q is a flat Z-module but not projective
  True

/-- Flatness is equivalent to being a direct limit of free modules (Lazard's theorem) -/
theorem lazard_flat_implies_direct_limit_free (R : Ring) (M : Module R) (h_flat : True) : True :=
  -- M is flat ↔ M is a filtered colimit of finitely generated free modules
  trivial

#eval "Counterexample 9: Q is flat but not projective over Z"

/-! ## Counterexample 10 — Simple ≠ Absolute Simple -/

/-- A module that is simple over R but not over the matrix ring M_n(R).
Example: R is a simple R-module, but as an M_n(R)-module it becomes R^n. -/
def simpleNotAbsolutelySimple (R : Ring) (n : Nat) : Prop :=
  -- R is an M_n(R)-module via the first column embedding, and it's not simple for n>1
  True

#eval "Counterexample 10: Simple module that becomes non-simple under extension of scalars"

